{
  "name": "web",
  "version": "1.0.0",
  "description": "SYNTHOMA - Interaktivní cyberpunk čtečka 💀",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:postgres": "node scripts/run-postgres-tests.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "next dev -p 3000",
    "build": "npm run content:generate && npm run content:validate && prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "validate:chapters": "node scripts/validate-books.js",
    "dialogs:migrate": "node scripts/migrate-book-dialogs.js --apply",
    "dialogs:audit": "node scripts/migrate-book-dialogs.js",
    "content:generate": "node scripts/generate-content.js",
    "content:validate": "node scripts/validate-content.js",
    "entitlements:backfill": "node scripts/backfill-content-entitlements.js"
  },
  "keywords": [
    "synthoma",
    "cyberpunk",
    "reader",
    "next.js"
  ],
  "author": "Synthoma",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "next": "^15.5.3",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "typescript": "^5.9.2"
  }
}
