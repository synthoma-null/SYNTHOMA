# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/synthoma"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Password recovery: SMTP service explicitly permitting this hosted application.
# Keep credentials only in local/deployment secrets, never in Git or chat.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Outside Vercel only: ingress must overwrite this header, not forward user input.
# Without a trusted header, authentication address limits are shared by all visitors.
TRUSTED_CLIENT_IP_HEADER=""
